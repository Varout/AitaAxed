<?xml version="1.1" ?>
<settings>
    <global>
        <auto_centre>true</auto_centre>
        <display_in_chat>false</display_in_chat>
        <duration>0</duration>
        <show_ability_name>false</show_ability_name> <!-- For Degei & Aita, toggles whether to show ability name -->
        <background>
            <opacity>75</opacity> <!-- 75 is the same as the default value for EquipViewer -->
        </background>
        <font>
            <size>50</size>
            <use_colours>true</use_colours>
        </font>
        <padding>25</padding>
        <pos>
            <x>700</x> <!-- Ignored if auto_centre is true -->
            <y>100</y>
        </pos>
        <update_gearswap>false</update_gearswap>
        <!-- Job specific settings as overrides -->
        <whm>
            <auto_centre>false</auto_centre>
            <pos>
                <x>1850</x>
                <y>650</y>
            </pos>
            <update_gearswap>false</update_gearswap>
        </whm>
    </global>
</settings>
